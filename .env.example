# Spotify Web API (https://developer.spotify.com)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# RapidAPI (YouTube trending, aggregated data sources)
RAPIDAPI_KEY=

# TheSportsDB - free, no key required for basic tier
# https://www.thesportsdb.com/api.php

# jService.io (Jeopardy questions) - free, no key required

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/multigame

# Redis (caching)
REDIS_URL=redis://localhost:6379

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
