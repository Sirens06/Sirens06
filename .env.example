# --- Required to run the app ---

# PostgreSQL connection string. Locally: create a db/role and run
# `npx prisma migrate dev`. See README for step-by-step setup.
DATABASE_URL=postgresql://user:password@localhost:5432/multigame

# Session encryption for NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Optional: OAuth login (email/password login works without these) ---

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Authorized redirect URI: <your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: external game data APIs (mock data is used when these are unset) ---

# Spotify Web API (https://developer.spotify.com) — also used for "Continua con
# Spotify" login if you add <your-domain>/api/auth/callback/spotify as a
# Redirect URI on the same Spotify app.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# RapidAPI (YouTube trending data for Higher/Lower)
RAPIDAPI_KEY=

# TMDB (Movie Location Scout) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# TheSportsDB and jService.io (Jeopardy) need no API key for basic use.

# --- Optional: production cron protection ---

# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET` (see vercel.json)
CRON_SECRET=
